# Build output (regenerated by CMake, never commit — contains absolute paths)
build/
out/

# CMake cache/generated files (in case a build happens in-source by mistake)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile

# Visual Studio / VS Code
.vs/
*.sln
*.vcxproj*
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Compiled binaries / debug symbols
*.obj
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.dll

# vcpkg (only relevant if you ever clone vcpkg *inside* the repo — most people
# have it in their user folder instead, per the lab instructions)
vcpkg/
vcpkg_installed/

# OS junk
Thumbs.db
.DS_Store
